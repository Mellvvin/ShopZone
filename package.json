{
  "name": "ecommerce-platform",
  "version": "1.0.0",
  "description": "ShopZone E-Commerce Platform",
  "main": "index.js",
  "scripts": {
    "start": "node backend/server.js",
    "server": "cd backend && npx nodemon server.js",
    "client": "npm run dev --prefix frontend",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "share": "concurrently \"npm run server\" \"npm run client\" \"cloudflared tunnel --url http://localhost:5173\""
  },
  "author": "Melvin Waweru Munyua",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.5"
  },
  "dependencies": {
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0"
  }
}
